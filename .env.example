# Copy to .env and export before starting EveChat.
# Never commit real secrets.
EVECHAT_AUTH__JWT_SECRET=
EVECHAT_ENCRYPTION_KEY_V1=
EVECHAT_SERVER__PUBLIC_URL=http://localhost:3000
# EVECHAT_TELEGRAM__BOT_TOKEN=
# EVECHAT_TELEGRAM__WEBHOOK_URL=https://chat.example.com/api/v1/integrations/telegram/webhook
# EVECHAT_TELEGRAM__SECRET=
# EVECHAT_AI__ENABLED=false
# EVECHAT_AI__CLAUDE_API_KEY=
# FCM push for the Android agent app. Prefer a file outside the repository:
# FIREBASE_SERVICE_ACCOUNT_FILE=/opt/evechat/firebase-service-account.json
# Alternatively paste the full service-account JSON (single line):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# FIREBASE_SERVICE_ACCOUNT_JSON also accepts a path. GOOGLE_APPLICATION_CREDENTIALS
# works as the standard fallback. Without credentials the device endpoints still
# work; delivery is simply skipped.
